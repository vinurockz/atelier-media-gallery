<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy config. IIS (this file) forwards every request to the Node server
  (`node server/index.mjs`, default port 4000), which serves both the built SPA and /api.
  Requires the IIS "URL Rewrite" module and "Application Request Routing" (ARR) with
  proxy enabled. See DEPLOY-IIS.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NodeReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:4000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Compressing on the fly makes IIS hold back Teams' live updates. -->
    <urlCompression doDynamicCompression="false" />

    <security>
      <requestFiltering>
        <!-- Allow large photo/video uploads (~2 GB). IIS default is only 30 MB. -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
