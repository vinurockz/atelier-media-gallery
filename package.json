{
  "name": "proj-1-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/convert-videos.mjs",
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "server": "node server/index.mjs",
    "prebuild": "node scripts/convert-videos.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "media:convert": "node scripts/convert-videos.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "node --test server/teams.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "multer": "^1.4.5-lts.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.1.0"
  }
}
